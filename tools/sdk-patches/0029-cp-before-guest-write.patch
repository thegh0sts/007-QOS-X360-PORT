# CommandProcessor::OnBeforeGuestWrite() (virtual, empty): called just before the command processor writes guest
# memory (read pointer / scratch / event write-backs, MEM_WRITE, REG_TO_MEM, COND_WRITE, EVENT_WRITE_ZPD) or raises an
# interrupt. After one of these the game may reuse memory the GPU work so far read, so a renderer that copies guest
# memory in the background (native patch 0103's upload worker) finishes its copies here.
diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index eff81ea..cc739c0 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -185,6 +185,11 @@ class CommandProcessor {
 
   uint32_t ExecutePrimaryBuffer(uint32_t start_index, uint32_t end_index);
   virtual void OnPrimaryBufferEnd() {}
+  // own 0029: called just before the command processor writes guest memory (fences, read pointer and scratch
+  // write-backs, MEM_WRITE / REG_TO_MEM / COND_WRITE, event write-backs) or raises an interrupt: after one of these
+  // the game may reuse memory the GPU work so far read. A renderer that reads guest memory in the background
+  // finishes those reads here.
+  virtual void OnBeforeGuestWrite() {}
   // Virtual so a backend can tell indirect-buffer packets from primary-ring ones.
   virtual void ExecuteIndirectBuffer(uint32_t ptr, uint32_t length);
   bool ExecutePacket(memory::RingBuffer* reader);
