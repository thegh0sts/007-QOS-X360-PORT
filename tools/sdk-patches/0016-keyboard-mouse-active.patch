--- a/src/input/input_system.cpp
+++ b/src/input/input_system.cpp
@@ -44,6 +44,9 @@ REXCVAR_DEFINE_DOUBLE(right_stick_deadzone_percentage, 0.0, "Input",
 namespace rex::input {
 
 namespace {
+// Whether keyboard/mouse (the MnK driver's one device) is the device that last gave user 0 real input.
+std::atomic<bool> g_keyboard_mouse_active{false};
+constexpr DeviceId kMnkDeviceId = static_cast<DeviceId>(0x4D4E4B00);  // mnk_input_driver.cpp's kMnkDevice
 
 // Synthetic devices are parked past every physical ordinal so they cannot push
 // a real pad off guest user 0. SlotAssignment routes them by their synthetic
@@ -330,6 +333,9 @@ X_RESULT InputSystem::GetStateForUI(uint32_t user_index, X_INPUT_STATE* out_stat
     }
   }
 
+  if (user_index == 0) {
+    g_keyboard_mouse_active.store(active_devices_.Active(0) == kMnkDeviceId, std::memory_order_relaxed);
+  }
   if (!any) {
     UpdateConnectedUser(user_index, false);
     return X_ERROR_DEVICE_NOT_CONNECTED;
@@ -499,7 +505,9 @@ X_RESULT InputSystem::GetKeystroke(uint32_t user_index, uint32_t flags,
 
 namespace {
 std::atomic<int> g_pad_style{0};
-}
+}  // namespace
+
+bool KeyboardMouseActive() { return g_keyboard_mouse_active.load(std::memory_order_relaxed); }
 
 PadStyle ConnectedPadStyle() { return static_cast<PadStyle>(g_pad_style.load(std::memory_order_relaxed)); }
 void SetConnectedPadStyle(PadStyle style) { g_pad_style.store(static_cast<int>(style), std::memory_order_relaxed); }
