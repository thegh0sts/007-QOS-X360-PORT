+++ b/src/system/xsocket.cpp
@@ -72,6 +72,11 @@ constexpr uint8_t kMagic0 = 0x58, kMagic1 = 0x4E, kVersion = 1;
 // loopback copy instead (it doesn't depend on the host stack looping broadcasts back, or on a
 // network being up), so they drop flagged packets from a local address.
 constexpr uint8_t kViaBroadcast = 0x80;
+// Version-byte flag: sent from a VDP socket, so the payload starts with VDP's big-endian 16-bit game data
+// length (then the game data, then any voice data). A VDP packet that reaches a plain UDP socket is unwrapped
+// to the game data (007 multiplayer answers a System Link "getinfo", which comes from a UDP socket, from its
+// VDP socket: with the length still in front, the join list ignored every answer).
+constexpr uint8_t kViaVdp = 0x40;
 constexpr size_t kHeader = 4;
 // Synthetic peer addresses: 169.254.250.0/24 + n.
 constexpr uint32_t kSecureBase = 0xA9FEFA00;
