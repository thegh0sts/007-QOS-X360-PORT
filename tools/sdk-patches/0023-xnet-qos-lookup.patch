# XNetQosLookup answered at once (every target complete and contacted, 1 ms, 100 Mbit/s, no listen data) instead of
# a stub that left the result unset: 007 multiplayer's System Link join list only shows a server once its QoS
# lookup completes, so it stayed empty. After 0020 (netplay).
diff --git a/src/kernel/xam/xam_net.cpp b/src/kernel/xam/xam_net.cpp
index c51d343..e1140bb 100644
--- a/src/kernel/xam/xam_net.cpp
+++ b/src/kernel/xam/xam_net.cpp
@@ -716,6 +716,45 @@ u32 NetDll_XNetQosServiceLookup_entry(u32 caller, u32 flags, u32 event_handle, m
   return 0;
 }
 
+// System link server lists ask for each server's ping with XNetQosLookup and only list a server once the
+// answer comes back (007 multiplayer: the join list stayed empty while the stub left the result unset).
+// Answered at once: every target complete and contacted, 1 ms, 100 Mbit/s, no listen data.
+u32 NetDll_XNetQosLookup_entry(u32 caller, u32 num_targets, u32 xnaddr_ptrs, u32 xnkid_ptrs,
+                               u32 xnkey_ptrs, u32 num_gateways, u32 gateway_addrs,
+                               u32 service_ids, u32 num_probes, u32 bits_per_sec, u32 flags,
+                               u32 event_handle, mapped_u32 pqos) {
+  const uint32_t count = num_targets + num_gateways;
+  if (pqos) {
+    const uint32_t size = uint32_t(sizeof(XNQOS) + sizeof(XNQOSINFO) * (count ? count - 1 : 0));
+    auto qos_guest = REX_KERNEL_MEMORY()->SystemHeapAlloc(size);
+    auto qos = REX_KERNEL_MEMORY()->TranslateVirtual<XNQOS*>(qos_guest);
+    std::memset(qos, 0, size);
+    qos->count = count;
+    qos->count_pending = 0;
+    const uint16_t probes = uint16_t(num_probes ? num_probes : 1);
+    for (uint32_t i = 0; i < count; ++i) {
+      auto& info = qos->info[i];
+      info.flags = 0x01 | 0x02;  // XNET_XNQOSINFO_COMPLETE | XNET_XNQOSINFO_TARGET_CONTACTED
+      info.probes_xmit = probes;
+      info.probes_recv = probes;
+      info.rtt_min_in_msecs = 1;
+      info.rtt_med_in_msecs = 1;
+      info.up_bits_per_sec = 100000000;
+      info.down_bits_per_sec = 100000000;
+    }
+    *pqos = qos_guest;
+  }
+  if (netplay::Trace()) {
+    REXLOG_INFO("netplay: XNetQosLookup {} targets, {} gateways: answered (1 ms)", num_targets,
+                num_gateways);
+  }
+  if (event_handle) {
+    auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle);
+    if (ev) ev->Set(0, false);
+  }
+  return 0;
+}
