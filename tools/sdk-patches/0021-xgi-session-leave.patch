# XGI 0x000B0013 (XSessionLeaveLocal/Remote) answered with success: 007 multiplayer sends it when a match
# ends, and the SDK's "unimplemented" failure ended the process after the score screen.
diff --git a/src/kernel/xam/apps/xgi_app.cpp b/src/kernel/xam/apps/xgi_app.cpp
index 5a01490..fcdd70d 100644
--- a/src/kernel/xam/apps/xgi_app.cpp
+++ b/src/kernel/xam/apps/xgi_app.cpp
@@ -159,6 +159,22 @@ X_HRESULT XgiApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
                     user_count, xuid_array_ptr, user_index_array, private_slots_array);
       return X_E_SUCCESS;
     }
+    case 0x000B0013: {
+      // XSessionLeaveLocal / XSessionLeaveRemote: same layout as join (0x000B0012) without the
+      // private-slots array. 007 multiplayer sends it when a match ends; failing it ended the
+      // process after the score screen.
+      assert_true(!buffer_length || buffer_length == 20);
+      uint32_t session_ptr = memory::load_and_swap<uint32_t>(buffer + 0);
+      uint32_t user_count = memory::load_and_swap<uint32_t>(buffer + 4);
+      uint32_t xuid_array_ptr = memory::load_and_swap<uint32_t>(buffer + 8);
+      uint32_t user_index_array = memory::load_and_swap<uint32_t>(buffer + 12);
+      bool is_local = xuid_array_ptr == 0;
+
+      REXKRNL_DEBUG("{}({:08X}, {}, {:08X}, {:08X})",
+                    is_local ? "XGISessionLeaveLocal" : "XGISessionLeaveRemote", session_ptr,
+                    user_count, xuid_array_ptr, user_index_array);
+      return X_E_SUCCESS;
+    }
     case 0x000B0014: {
       assert_true(!buffer_length || buffer_length == 16);
 
