 // button-press sequences (takedowns, quick-time events) shown as the pad's diamond, so WASD answer them.
 std::atomic<bool> stick_keys_face{false};
+// Menu mode: while on, the keys bound to Start press B instead (back), e.g. Esc pauses in game and goes back in
+// menus. The game turns it on while a menu has focus.
+std::atomic<bool> start_keys_back{false};
+// A press keeps the meaning it started with: Esc opening the pause menu (which turns menu mode on) must not
+// become a B press, and close it again, while it's still held.
+bool start_press_is_back = false;
 std::mutex mouse_direct_mutex;
 double mouse_direct_dx = 0.0, mouse_direct_dy = 0.0;
 
@@ -351,6 +357,10 @@ void SetStickKeysAsFaceButtons(bool on) {
   stick_keys_face.store(on, std::memory_order_relaxed);
 }
 
+void SetStartKeysAsBack(bool on) {
+  start_keys_back.store(on, std::memory_order_relaxed);
+}
+
 bool StickKeysAsFaceButtons() {
   return stick_keys_face.load(std::memory_order_relaxed);
 }
