ReXGlue input: Start keys as B in menus (SetStartKeysAsBack).

While on, the keys bound to Start press B instead, so a pause key such as Esc also goes back in menus.
The game turns it on while a menu has focus. A press keeps the meaning it started with (Esc opening
the pause menu stays Start until released). Off by default; keyboard only.

diff --git a/include/rex/input/mnk/mnk_input_driver.h b/include/rex/input/mnk/mnk_input_driver.h
index 283e51b..5088fe8 100644
--- a/include/rex/input/mnk/mnk_input_driver.h
+++ b/include/rex/input/mnk/mnk_input_driver.h
@@ -31,6 +31,9 @@ bool ConsumeMouseDelta(float* dx, float* dy);
 // left X, down A, right B (button-press sequences shown as the pad's diamond). Off by default.
 void SetStickKeysAsFaceButtons(bool on);
 bool StickKeysAsFaceButtons();
+// While on, the keys bound to Start press B (back) instead: a game turns it on while a menu has focus, so its pause
+// key (Esc) also goes back in menus. Off by default.
+void SetStartKeysAsBack(bool on);
 bool IsMouseLookActive();
 
 class MnkInputDriver final : public InputDriver,
diff --git a/src/input/mnk/mnk_input_driver.cpp b/src/input/mnk/mnk_input_driver.cpp
index bfadbe3..429a877 100644
--- a/src/input/mnk/mnk_input_driver.cpp
+++ b/src/input/mnk/mnk_input_driver.cpp
@@ -191,6 +191,12 @@ std::atomic<bool> mouse_direct{false};
