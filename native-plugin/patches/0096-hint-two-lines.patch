diff --git a/src/gfx/vk/present.cpp b/src/gfx/vk/present.cpp
index 6d0930b..271956e 100644
--- a/src/gfx/vk/present.cpp
+++ b/src/gfx/vk/present.cpp
@@ -37,7 +37,7 @@ layout(set = 0, binding = 1) uniform Gamma {
   uvec4 toast_icon[484]; // 44x44 RGBA8
   uvec4 hint;            // x: opacity (float bits, 0 = none), y: width, z: height (image pixels = 1080p pixels)
   vec4 hint_at;          // xy: top-left in pixels of a 1920x1080 picture
-  uvec4 hint_image[1920]; // up to 7680 RGBA8 texels (256 wide, 48 high at most), row by row, width hint.y
+  uvec4 hint_image[3400]; // up to 13600 RGBA8 texels (256 wide, 96 high at most), row by row, width hint.y
 };
 layout(location = 0) out vec4 result;
 
@@ -331,8 +331,11 @@ constexpr VkFormat kGuestOutputFormat = VK_FORMAT_A2B10G10R10_UNORM_PACK32;
 // icon)
 constexpr VkDeviceSize kOverlayBytes = 10 * 16 + 16 + 8 * 16;
 constexpr VkDeviceSize kToastBytes = 16 + 5 * 16 + 48 * 16 + 484 * 16;
-constexpr VkDeviceSize kHintBytes = 16 + 16 + 1920 * 16;
+constexpr VkDeviceSize kHintBytes = 16 + 16 + 3400 * 16;
 constexpr VkDeviceSize kRampBytes = 256 * 4 + 16 + kOverlayBytes + kToastBytes + kHintBytes;
+// qos (0096): one uniform buffer holds all of this; 65536 bytes is the most every desktop GPU allows (NVIDIA's
+// maxUniformBufferRange), so the hint image can't grow past it.
+static_assert(kRampBytes <= 65536, "the present pass's uniform buffer is over 64 KB");
 
 }  // namespace
 
