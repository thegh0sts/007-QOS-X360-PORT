diff --git a/src/gfx/vk/present.cpp b/src/gfx/vk/present.cpp
index 271956e..2f44e69 100644
--- a/src/gfx/vk/present.cpp
+++ b/src/gfx/vk/present.cpp
@@ -469,8 +469,34 @@ bool Renderer::InitPresent() {
   return present_pipeline_ != VK_NULL_HANDLE;
 }
 
+void Renderer::PollTraceTrigger() {
+  if (trace_frames_left_ > 0) {
+    if (--trace_frames_left_ == 0) {
+      std::fprintf(stderr, "=== draw trace end (after draw %llu) ===\n", (unsigned long long)stats_.draws);
+      std::fflush(stderr);
+      REXLOG_INFO("gfx native: draw trace (trace-now) done");
+    }
+    return;
+  }
+  if (++trace_poll_ % 30) return;
+  std::error_code ec;
+  if (!std::filesystem::exists("trace-now", ec)) return;
+  std::filesystem::remove("trace-now", ec);
+  static const uint32_t frames = [] {
+    const char* v = std::getenv("BOTS_DRAW_TRACE_FRAMES");
+    const int n = v ? std::atoi(v) : 2;
+    return uint32_t(std::clamp(n, 1, 60));
+  }();
+  trace_frames_left_ = frames;
+  trace_dumped_.clear();
+  std::fprintf(stderr, "=== draw trace start: %u frames, from draw %llu ===\n", frames,
+               (unsigned long long)stats_.draws + 1);
+  REXLOG_INFO("gfx native: draw trace for {} frames (trace-now found)", frames);
+}
+
 bool Renderer::Present(uint32_t address, VkImage target, VkImageView target_view, uint32_t width, uint32_t height,
                        const uint32_t* gamma_ramp) {
