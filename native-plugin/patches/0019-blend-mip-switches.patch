From 911c6dfa3e516fa256c086f4341473fa35456bbb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 23:52:40 +1100
Subject: [PATCH] qos: BOTS_GFX_NO_BLEND and BOTS_GFX_BASE_LEVEL_ONLY debug switches

---
 src/gfx/vk/draw.cpp    | 7 +++++++
 src/gfx/vk/texture.cpp | 6 ++++++
 2 files changed, 13 insertions(+)

diff --git a/src/gfx/vk/draw.cpp b/src/gfx/vk/draw.cpp
index b1b3530..85619dc 100644
--- a/src/gfx/vk/draw.cpp
+++ b/src/gfx/vk/draw.cpp
@@ -1626,6 +1626,13 @@ void Renderer::IssueDraw(const rg::RegisterFile& regs, const ShaderLoad& vs, con
     if (!attachments.color[i]) continue;
     key.write_mask[i] = (color_mask >> (4 * i)) & 0xF;
     key.blend[i] = regs.values[reg::RB_BLENDCONTROL::rt_register_indices[i]] & 0x1FFF1FFF;
+    // BOTS_GFX_NO_BLEND=1 (tbc, debugging 007's menu): blending off (source one, destination zero), so every draw
+    // covers its triangles whatever alpha it outputs.
+    static const bool no_blend = [] {
+      const char* v = std::getenv("BOTS_GFX_NO_BLEND");
+      return v && *v == '1';
+    }();
+    if (no_blend) key.blend[i] = 0x00010001;
   }
 
   bool pending = false;
diff --git a/src/gfx/vk/texture.cpp b/src/gfx/vk/texture.cpp
index 69ff8a2..6c90c58 100644
--- a/src/gfx/vk/texture.cpp
+++ b/src/gfx/vk/texture.cpp
@@ -695,6 +695,12 @@ VkSampler Renderer::GetSampler(const rg::xenos::xe_gpu_texture_fetch_t& fetch,
   info.minLod = float(fetch.mip_min_level);
   info.maxLod = mip == xe::TextureFilter::kBaseMap ? info.minLod + 0.25f
                                                    : float(std::max(fetch.mip_min_level, fetch.mip_max_level));
+  // BOTS_GFX_BASE_LEVEL_ONLY=1 (tbc, debugging 007's menu): every sampler reads the fetch's base level only.
+  static const bool base_level_only = [] {
+    const char* v = std::getenv("BOTS_GFX_BASE_LEVEL_ONLY");
+    return v && *v == '1';
+  }();
+  if (base_level_only) info.maxLod = info.minLod + 0.25f;
   if (aniso != xe::AnisoFilter::kDisabled) {
     // Like the SDK (and D3D): anisotropic filtering forces linear min/mag/mip.
     info.magFilter = info.minFilter = VK_FILTER_LINEAR;
-- 
2.43.0

