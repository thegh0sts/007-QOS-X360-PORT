+// qos (patch 0107): see hoist_diag_.
+void Renderer::DiagNoteRead(uint32_t start, uint32_t length) {
+  if (diag_stamp_ != page_stamp_) {
+    diag_stamp_ = page_stamp_;
+    diag_reads_.clear();
+    diag_page_reads_.clear();
+  }
+  if (uint64_t(start) + length > uint64_t(read_bits_.size()) << 18) return;
+  const bool hashed = length <= (256u << 10);
+  const uint32_t index = uint32_t(diag_reads_.size());
+  diag_reads_.push_back({start, length, hashed ? XXH3_64bits(memory_(start), length) : 0, hashed});
+  ++diag_.reads;
+  for (uint32_t page = start >> 12, last = (start + length - 1) >> 12; page <= last; ++page) {
+    diag_page_reads_[page].push_back(index);
+  }
+}
+
+void Renderer::DiagInPlace(uint32_t start, uint32_t length) {
+  ++diag_.in_place;
+  if (diag_stamp_ != page_stamp_ || !ReadThisSubmission(start, length)) {
+    ++diag_.other;  // ring space, not a read
+    return;
+  }
+  ++diag_.by_reads;
+  const uint32_t first = start >> 12, last = (start + length - 1) >> 12;
+  diag_.pages += last - first + 1;
+  std::vector<uint32_t> seen;
+  uint32_t changed = 0, unchanged = 0, too_big = 0;
+  const DiagRead* example = nullptr;
+  bool example_changed = false;
+  for (uint32_t page = first; page <= last; ++page) {
+    const auto it = diag_page_reads_.find(page);
+    if (it == diag_page_reads_.end()) continue;
+    bool page_changed = false;
+    for (const uint32_t index : it->second) {
+      if (std::find(seen.begin(), seen.end(), index) != seen.end()) continue;
+      seen.push_back(index);
+      const DiagRead& read = diag_reads_[index];
+      bool is_changed;
+      if (!read.hashed) {
+        ++too_big;
+        is_changed = true;
+      } else if (XXH3_64bits(memory_(read.start), read.length) != read.hash) {
+        ++changed;
+        is_changed = true;
+      } else {
+        ++unchanged;
+        is_changed = false;
+      }
+      page_changed = page_changed || is_changed;
+      if (!example || (is_changed && !example_changed)) example = &read, example_changed = is_changed;
+    }
+    diag_.read_pages_changed += page_changed;
+  }
+  if (too_big) {
+    ++diag_.too_big;
+  } else if (changed) {
+    ++diag_.changed;
+  } else {
+    ++diag_.unchanged;
+  }
+  if (diag_samples_ < 16) {
+    ++diag_samples_;
+    REXLOG_INFO("gfx native: in-place upload {:08X}+{} ({} pages): {} earlier reads of the submission overlap ({} bytes "
+                "unchanged, {} changed, {} too big to hash), e.g. {:08X}+{} {}; {} reads so far",
+                start, length, last - first + 1, seen.size(), unchanged, changed, too_big, example ? example->start : 0,
+                example ? example->length : 0, example_changed ? "changed" : "unchanged", diag_reads_.size());
+  }
+}
+
+void Renderer::LogHoistDiag() {
+  if (!hoist_diag_) return;
+  const DiagStats& a = diag_last_;
+  const DiagStats& b = diag_;
+  REXLOG_INFO("gfx native: in-place uploads (diagnostic, window totals): {} - {} for pages read this submission: {} "
+              "with the read bytes unchanged (could move ahead), {} changed, {} with a read too big to hash; {} for "
+              "other reasons. {} pages in them ({} with a changed read); {} reads recorded",
+              b.in_place - a.in_place, b.by_reads - a.by_reads, b.unchanged - a.unchanged, b.changed - a.changed,
+              b.too_big - a.too_big, b.other - a.other, b.pages - a.pages, b.read_pages_changed - a.read_pages_changed,
+              b.reads - a.reads);
+  diag_last_ = diag_;
+  diag_samples_ = 0;
+}
