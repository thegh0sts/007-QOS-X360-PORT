+// qos (patch 0110): list a texture under the 64 KB blocks of its ranges (again if they changed).
+void Renderer::IndexTexture(GuestTexture& texture) {
+  if (texture.indexed) {
+    if (texture.indexed_ranges == texture.ranges) return;
+    UnindexTexture(texture);
+  }
+  for (const auto& [start, end] : texture.ranges) {
+    if (end <= start) continue;
+    for (uint32_t block = start >> kTextureBlockShift;; ++block) {
+      auto& textures = texture_blocks_[block];
+      if (textures.empty() || textures.back() != &texture) textures.push_back(&texture);
+      if (block == (end - 1) >> kTextureBlockShift) break;
+    }
+  }
+  texture.indexed = true;
+  texture.indexed_ranges = texture.ranges;
+}
+
+void Renderer::UnindexTexture(GuestTexture& texture) {
+  if (!texture.indexed) return;
+  for (const auto& [start, end] : texture.indexed_ranges) {
+    if (end <= start) continue;
+    for (uint32_t block = start >> kTextureBlockShift;; ++block) {
+      if (const auto bucket = texture_blocks_.find(block); bucket != texture_blocks_.end()) {
+        std::erase(bucket->second, &texture);
+        if (bucket->second.empty()) texture_blocks_.erase(bucket);
+      }
+      if (block == (end - 1) >> kTextureBlockShift) break;
+    }
+  }
+  texture.indexed = false;
+  texture.indexed_ranges = {};
+}
+
+void Renderer::LogInvalidationProfile(double frames) {
+  const InvalidationProfile& a = inval_prof_;
+  InvalidationProfile& b = inval_prof_last_;
+  if (frames <= 0) return;
+  REXLOG_INFO("gfx native: CPU-write checks per frame: {:.1f} batches ({:.1f} ranges), {:.3f} ms, {:.0f} textures "
+              "checked, {:.1f} marked changed; {} textures kept, {} blocks listed{}",
+              double(a.batches - b.batches) / frames, double(a.ranges - b.ranges) / frames,
+              double(a.ns - b.ns) / 1e6 / frames, double(a.checked - b.checked) / frames,
+              double(a.dirtied - b.dirtied) / frames, guest_textures_.size(), texture_blocks_.size(),
+              texture_index_ ? "" : " (index off)");
+  b = a;
+}
