+  // since. Recorded here, after the pass and its transfers (which bind other layouts and would disturb it).
+  if (push_pending) {
+    const uint32_t n = push.views + push.samplers;
+    const bool same = same_layout && push_memo_epoch_ == texture_sets_epoch_ && push_memo_.layout == push.layout &&
+                      push_memo_.views == push.views && push_memo_.samplers == push.samplers &&
+                      std::memcmp(push_memo_.handles, push.handles, n * sizeof(uint64_t)) == 0;
+    if (same) {
+      if (draw_profile_) ++sub_.pushes_skipped;
+    } else {
+      if (draw_profile_) ++sub_.pushes;
+      push_memo_ = push, push_memo_epoch_ = texture_sets_epoch_;
+      Rec([this, p = push](VkCommandBuffer cmd) {
+        VkDescriptorImageInfo infos[32];
+        const uint32_t count = p.views + p.samplers;
+        for (uint32_t i = 0; i < count; ++i) {
+          infos[i] = i < p.views ? VkDescriptorImageInfo{VK_NULL_HANDLE, VkImageView(p.handles[i]),
+                                                         VK_IMAGE_LAYOUT_GENERAL}
