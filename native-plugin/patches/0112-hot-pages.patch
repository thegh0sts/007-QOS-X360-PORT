+
+uint64_t MemorySync::PageHash(uint32_t page) const {
+  return XXH3_64bits(memory().TranslatePhysical<const uint8_t*>(page << page_size_log2()), size_t(1) << page_size_log2());
+}
+
+void MemorySync::QueueChanged(uint32_t page_first, uint32_t page_count) {
+  const uint32_t first = page_first << page_size_log2(), last = ((page_first + page_count) << page_size_log2()) - 1;
+  std::lock_guard lock(mutex_);
+  if (!invalidated_.empty() && invalidated_.back().second + 1 == first) {
+    invalidated_.back().second = last;
+  } else {
+    invalidated_.emplace_back(first, last);
+  }
+  pending_.store(true, std::memory_order_release);
+}
+
+bool MemorySync::RequestVertex(uint32_t start, uint32_t length) {
+  if (!hot_on_) return Request(start, length);
+  vertex_request_ = true;
+  const bool ok = Request(start, length);
+  vertex_request_ = false;
+  return ok;
+}
+
+bool MemorySync::AnyHot(uint32_t page_first, uint32_t page_last) const {
+  for (uint32_t block = page_first >> 6; block <= page_last >> 6; ++block) {
+    const uint32_t lo = block == page_first >> 6 ? page_first & 63 : 0;
+    const uint32_t hi = block == page_last >> 6 ? page_last & 63 : 63;
+    const uint64_t bits = (hi == 63 ? ~uint64_t(0) : (uint64_t(1) << (hi + 1)) - 1) & ~((uint64_t(1) << lo) - 1);
+    if (hot_[block] & bits) return true;
+  }
+  return false;
+}
+
+bool MemorySync::Unwatched(uint32_t start, uint32_t length) {
+  if (!hot_on_ || !length || start >= kBufferSize) return false;
+  const uint64_t end = std::min<uint64_t>(uint64_t(start) + length, kBufferSize);
+  return AnyHot(start >> page_size_log2(), uint32_t((end - 1) >> page_size_log2()));
+}
+
+void MemorySync::SetHot(uint32_t page, bool hot) {
+  const uint64_t bit = uint64_t(1) << (page & 63);
+  if (hot) {
+    hot_[page >> 6] |= bit;
+    ++hot_stats_.count;
+  } else {
+    hot_[page >> 6] &= ~bit;
+    --hot_stats_.count;
+  }
+  hot_known_[page >> 6] &= ~bit;
+}
+
+// A vertex request's upload through the SDK (protected path): counts frames running; 3 make the page hot.
+void MemorySync::HotNoteUpload(uint32_t page_first, uint32_t page_count) {
+  const uint32_t frame = uint32_t(renderer_.frame_number()) + 1;
+  for (uint32_t page = page_first; page < page_first + page_count; ++page) {
+    const uint32_t last = up_frame_[page];
+    if (last == frame) continue;
+    up_streak_[page] = last == frame - 1 ? uint8_t(std::min(up_streak_[page] + 1, 250)) : 1;
+    up_frame_[page] = frame;
+    if (up_streak_[page] >= 3 && !IsHot(page)) {
+      SetHot(page, true);
+      hot_changed_frame_[page] = frame;
+      ++hot_stats_.promoted;
+    }
+  }
+}
+
+bool MemorySync::HotRequest(uint32_t start, uint32_t length, uint32_t page_first, uint32_t page_last) {
+  const uint32_t page_log2 = page_size_log2();
+  const uint64_t end = uint64_t(start) + length;
+  bool ok = true;
+  for (uint32_t page = page_first; page <= page_last;) {
+    const bool hot = IsHot(page);
+    uint32_t last = page;
+    while (last < page_last && IsHot(last + 1) == hot) ++last;
+    if (hot) {
+      ok = HotCheck(page, last - page + 1) && ok;
+    } else {
+      const uint32_t sub_start = std::max(start, page << page_log2);
+      const uint32_t sub_end = uint32_t(std::min<uint64_t>(end, uint64_t(last + 1) << page_log2));
+      ok = SlowRequest(sub_start, sub_end - sub_start) && ok;
+    }
+    page = last + 1;
+  }
+  renderer_.NoteSharedRead(start, length);  // after its uploads, which may go ahead of it
+  return ok;
+}
+
+bool MemorySync::HotCheck(uint32_t page_first, uint32_t page_count) {
+  const uint32_t page_log2 = page_size_log2();
+  const uint32_t frame = uint32_t(renderer_.frame_number()) + 1;
+  const uint64_t t0 = profile_on_ ? NowNs() : 0;
+  bool ok = true;
+  hot_hashes_.resize(page_count);
+  // Hash first, copy after: a write between the two makes the stored hash older than the copy, never newer.
+  for (uint32_t i = 0; i < page_count; ++i) hot_hashes_[i] = PageHash(page_first + i);
+  hot_stats_.checked += page_count;
+  auto known = [&](uint32_t page) { return (hot_known_[page >> 6] >> (page & 63)) & 1; };
+  auto same = [&](uint32_t i) {
+    const uint32_t page = page_first + i;
+    return known(page) && hot_hash_[page] == hot_hashes_[i];
+  };
+  for (uint32_t i = 0; i < page_count;) {
+    const uint32_t page = page_first + i;
+    if (same(i)) {
+      if (frame - hot_changed_frame_[page] > kHotIdleFrames) {
+        // Quiet: back to protection (uploaded and watched by the SDK; its GPU copy is current, the upload is spare).
+        SetHot(page, false);
+        ++hot_stats_.demoted_idle;
+        ok = SlowRequest(page << page_log2, 1u << page_log2) && ok;
+      }
+      ++i;
+      continue;
+    }
+    uint32_t n = 1;
+    while (i + n < page_count && !same(i + n)) ++n;
+    for (uint32_t k = 0; k < n; ++k) {
+      if (known(page + k)) QueueChanged(page + k, 1);  // no write fault told the caches
+    }
+    if (!renderer_.UploadGuestMemory(page << page_log2, n << page_log2)) {
+      ok = false;
+    } else {
+      for (uint32_t k = 0; k < n; ++k) {
+        hot_hash_[page + k] = hot_hashes_[i + k];
+        hot_known_[(page + k) >> 6] |= uint64_t(1) << ((page + k) & 63);
+        hot_changed_frame_[page + k] = frame;
+      }
+      hot_stats_.copied += n, ++hot_stats_.copy_runs;
+      uploading_ = true;
+    }
+    i += n;
+  }
+  if (profile_on_) hot_stats_.ns += NowNs() - t0;
+  return ok;
+}
+
+void MemorySync::LogHotPages(double frames) {
+  if (!hot_on_ || frames <= 0) return;
+  const HotStats& a = hot_stats_;
+  HotStats& b = hot_stats_last_;
+  auto per = [&](uint64_t x, uint64_t y) { return double(x - y) / frames; };
+  REXLOG_INFO("gfx native: hot vertex pages per frame: {:.0f} checked by hash ({:.2f} ms), {:.0f} copied in {:.0f} "
+              "runs; {:.1f} made hot, {:.1f} back to protection when quiet, {:.1f} when other requests read them; {} hot "
+              "now",
+              per(a.checked, b.checked), per(a.ns, b.ns) / 1e6, per(a.copied, b.copied), per(a.copy_runs, b.copy_runs),
+              per(a.promoted, b.promoted), per(a.demoted_idle, b.demoted_idle), per(a.demoted_other, b.demoted_other),
+              a.count);
+  b = a;
+}
