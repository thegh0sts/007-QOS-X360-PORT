+bool InflateZlib(const uint8_t* in, size_t in_size, std::vector<uint8_t>& out) {
+  if (in_size > size_t(INT32_MAX) || out.size() > size_t(INT32_MAX)) return false;
+  const int n = stbi_zlib_decode_buffer(reinterpret_cast<char*>(out.data()), int(out.size()),
+                                        reinterpret_cast<const char*>(in), int(in_size));
+  return n >= 0 && size_t(n) == out.size();
+}
