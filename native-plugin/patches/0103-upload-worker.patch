diff --git a/src/gfx/vk/upload_worker.h b/src/gfx/vk/upload_worker.h
new file mode 100644
index 0000000..e1bea6d
--- /dev/null
+++ b/src/gfx/vk/upload_worker.h
@@ -0,0 +1,118 @@
+// qos (patch 0103): a worker thread for the CPU half of guest-memory uploads. BOTS_GFX_UPLOAD_WORKER=1 starts it.
+// An upload copies the pages the game rewrote into the submission's staging ring, then records the GPU copy from
+// there; that memcpy ran on the render thread, between the draw that needed the pages and everything after it. Now a
+// copy of min_bytes() or more is handed to this worker and the render thread goes on with the draw (textures,
+// descriptors, constants...) while it runs. Its result is needed only when the submission is submitted, and the
+// game may change the source only after the GPU work signals it (a fence or other write-back, an interrupt), so the
+// render thread waits for the copies (Drain) before submitting (Renderer::Flush) and before the command processor
+// writes guest memory or raises an interrupt (SDK patch 0029, CommandProcessor::OnBeforeGuestWrite).
+//
+// One producer (the render thread), one consumer. A ring of jobs with two counters; each side sleeps (atomic wait)
+// only after spinning a little, and the other wakes it only when it says it's asleep.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <thread>
+
+#if defined(_MSC_VER)
+#include <intrin.h>
+#define BOTS_UPLOAD_PAUSE() _mm_pause()
+#elif defined(__x86_64__) || defined(__i386__)
+#include <immintrin.h>
+#define BOTS_UPLOAD_PAUSE() _mm_pause()
+#else
+#define BOTS_UPLOAD_PAUSE() std::this_thread::yield()
+#endif
+
+namespace bots::gfx::vk {
+
+class UploadWorker {
+ public:
+  // Copies smaller than this are done in place (handing one over costs more than copying it).
+  // BOTS_GFX_UPLOAD_WORKER_MIN_KB sets it (default 4; 16 in the first test, 26 Nov: 3-4% per draw, most copies smaller).
+  static constexpr size_t kDefaultMinBytes = 4 * 1024;
+
+  explicit UploadWorker(size_t min_bytes = kDefaultMinBytes) : min_bytes_(min_bytes), thread_([this] { Run(); }) {}
+  size_t min_bytes() const { return min_bytes_; }
+  ~UploadWorker() {
+    quit_.store(true);
+    Push(nullptr, nullptr, 0);  // an empty job: a sleeping worker wakes only for a new count
+    thread_.join();
+  }
+  UploadWorker(const UploadWorker&) = delete;
+  UploadWorker& operator=(const UploadWorker&) = delete;
+
+  void Push(void* dst, const void* src, size_t bytes) {
+    const uint64_t p = pushed_.load(std::memory_order_relaxed);
+    if (p - done_.load(std::memory_order_acquire) >= kSlots) Drain();  // full
+    jobs_[p % kSlots] = {static_cast<uint8_t*>(dst), static_cast<const uint8_t*>(src), bytes};
+    pushed_.store(p + 1);
+    if (worker_asleep_.load()) pushed_.notify_one();
+    ++jobs_pushed_;
+    bytes_pushed_ += bytes;
+  }
+
+  // Returns once every copy handed over so far is done.
+  void Drain() {
+    const uint64_t target = pushed_.load(std::memory_order_relaxed);
+    for (int spin = 0; done_.load(std::memory_order_acquire) != target; ++spin) {
+      if (spin < 4000) {
+        BOTS_UPLOAD_PAUSE();
+        continue;
+      }
+      drainer_asleep_.store(true);
+      const uint64_t seen = done_.load();
+      if (seen != target) done_.wait(seen);
+      drainer_asleep_.store(false);
+    }
+  }
+
+  uint64_t jobs() const { return jobs_pushed_; }
+  uint64_t bytes() const { return bytes_pushed_; }
+
+ private:
+  struct Job {
+    uint8_t* dst;
+    const uint8_t* src;
+    size_t bytes;
+  };
+  static constexpr uint64_t kSlots = 4096;
+
+  void Run() {
+    uint64_t next = 0;
+    for (;;) {
+      uint64_t available = pushed_.load(std::memory_order_acquire);
+      for (int spin = 0; available == next && spin < 20000; ++spin) {
+        BOTS_UPLOAD_PAUSE();
+        available = pushed_.load(std::memory_order_acquire);
+      }
+      if (available == next) {
+        if (quit_.load()) return;
+        worker_asleep_.store(true);
+        available = pushed_.load();
+        if (available == next && !quit_.load()) pushed_.wait(next);
+        worker_asleep_.store(false);
+        continue;
+      }
+      if (quit_.load() && available == next + 1 && !jobs_[next % kSlots].bytes) return;
+      while (next != available) {
+        const Job& job = jobs_[next % kSlots];
+        if (job.bytes) std::memcpy(job.dst, job.src, job.bytes);
+        ++next;
+        done_.store(next);
+        if (drainer_asleep_.load()) done_.notify_all();
+      }
+    }
+  }
+
+  Job jobs_[kSlots];
+  std::atomic<uint64_t> pushed_{0}, done_{0};
+  std::atomic<bool> worker_asleep_{false}, drainer_asleep_{false}, quit_{false};
+  uint64_t jobs_pushed_ = 0, bytes_pushed_ = 0;  // render thread only
+  const size_t min_bytes_;
+  std::thread thread_;
+};
+
+}  // namespace bots::gfx::vk
