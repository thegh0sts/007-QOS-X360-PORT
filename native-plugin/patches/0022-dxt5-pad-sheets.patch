+std::vector<uint8_t> BuildDxtSheet(int sheet, const uint8_t* guest, uint32_t pitch) {
+  const auto& config = Config();
+  if (sheet < 0 || size_t(sheet) >= config.sheets.size()) return {};
+  const PadSheet& s = config.sheets[sheet];
+  std::vector<uint8_t> out = UntileDxt5(guest, s.width, s.height, pitch);
