+// qos: a tiled DXT5 base level as the guest has it (8-in-16 endian), pitch in texels, to RGBA8 rows.
+std::vector<uint8_t> UntileDxt5(const uint8_t* guest, uint32_t width, uint32_t height, uint32_t pitch) {
+  std::vector<uint8_t> rgba(size_t(width) * height * 4);
+  const uint32_t pitch_blocks = ((std::max(pitch, width) / 4) + 31) & ~31u;
+  for (uint32_t by = 0; by < height / 4; ++by) {
+    for (uint32_t bx = 0; bx < width / 4; ++bx) {
+      const uint8_t* p = guest + TiledOffset(bx, by, pitch_blocks, 4);
+      uint8_t b[16];
+      for (int i = 0; i < 16; i += 2) b[i] = p[i + 1], b[i + 1] = p[i];  // 8-in-16 swap
+      const uint32_t a0 = b[0], a1 = b[1];
+      uint64_t ai = 0;
+      for (int i = 0; i < 6; ++i) ai |= uint64_t(b[2 + i]) << (8 * i);
+      uint32_t ap[8] = {a0, a1};
+      if (a0 > a1) {
+        for (int i = 0; i < 6; ++i) ap[2 + i] = ((6 - i) * a0 + (i + 1) * a1) / 7;
+      } else {
+        for (int i = 0; i < 4; ++i) ap[2 + i] = ((4 - i) * a0 + (i + 1) * a1) / 5;
+        ap[6] = 0, ap[7] = 255;
+      }
+      const uint32_t c0 = b[8] | b[9] << 8, c1 = b[10] | b[11] << 8;
+      const uint32_t ci = b[12] | b[13] << 8 | b[14] << 16 | uint32_t(b[15]) << 24;
+      auto rgb = [](uint32_t c, uint32_t* o) {
+        o[0] = ((c >> 11) & 31) * 255 / 31, o[1] = ((c >> 5) & 63) * 255 / 63, o[2] = (c & 31) * 255 / 31;
+      };
+      uint32_t pal[4][3];
+      rgb(c0, pal[0]);
+      rgb(c1, pal[1]);
+      for (int k = 0; k < 3; ++k) {
+        pal[2][k] = (2 * pal[0][k] + pal[1][k]) / 3;
+        pal[3][k] = (pal[0][k] + 2 * pal[1][k]) / 3;
+      }
+      for (uint32_t i = 0; i < 16; ++i) {
+        const uint32_t x = bx * 4 + (i & 3), y = by * 4 + (i >> 2);
+        uint8_t* q = &rgba[(size_t(y) * width + x) * 4];
+        const uint32_t* c = pal[(ci >> (2 * i)) & 3];
+        q[0] = uint8_t(c[0]), q[1] = uint8_t(c[1]), q[2] = uint8_t(c[2]);
+        q[3] = uint8_t(ap[(ai >> (3 * i)) & 7]);
+      }
+    }
+  }
+  return rgba;
+}
