+void Renderer::LogSubProfile(double frames) {
+  if (!draw_profile_ || frames <= 0) return;
+  const SubProfile& a = sub_;
+  SubProfile& b = sub_last_;
+  auto ms = [&](uint64_t x, uint64_t y) { return double(x - y) / 1e6 / frames; };
+  auto per = [&](uint64_t x, uint64_t y) { return double(x - y) / frames; };
+  REXLOG_INFO("gfx native: draw sub-phases per frame ({:.0f} draws reaching constants): constants: viewport {:.2f} "
+              "ms, system {:.2f}, float {:.2f}, bool/loop+fetch {:.2f}; uploads/reuses: system {:.0f}/{:.0f}, vertex "
+              "floats {:.0f}/{:.0f}, pixel floats {:.0f}/{:.0f}, bool/loop {:.0f}/{:.0f}, fetch {:.0f}/{:.0f}; "
+              "descriptors: layout {:.2f} ms, texture sets {:.2f} ms, updates {:.2f} ms; sets: {:.0f} none, {:.0f} as "
+              "last draw, {:.0f} found, {:.0f} new",
+              per(a.draws, b.draws), ms(a.viewport_ns, b.viewport_ns), ms(a.system_ns, b.system_ns),
+              ms(a.floats_ns, b.floats_ns), ms(a.misc_ns, b.misc_ns), per(a.uploads[0], b.uploads[0]),
+              per(a.reuses[0], b.reuses[0]), per(a.uploads[1], b.uploads[1]), per(a.reuses[1], b.reuses[1]),
+              per(a.uploads[2], b.uploads[2]), per(a.reuses[2], b.reuses[2]), per(a.uploads[3], b.uploads[3]),
+              per(a.reuses[3], b.reuses[3]), per(a.uploads[4], b.uploads[4]), per(a.reuses[4], b.reuses[4]),
+              ms(a.layout_ns, b.layout_ns), ms(a.sets_ns, b.sets_ns), ms(a.update_ns, b.update_ns),
+              per(a.set_empty, b.set_empty), per(a.set_memo, b.set_memo), per(a.set_map, b.set_map),
+              per(a.set_new, b.set_new));
+  b = a;
+}
