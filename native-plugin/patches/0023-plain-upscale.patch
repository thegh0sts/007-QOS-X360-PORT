+  // qos: 007 draws its 3D view at 1024x608 (2x MSAA), then stretches it to the 1280x720 front buffer with a filter
+  // that reads whole guest texels, so above render scale 1 the scaled view still reached the screen at 1024 columns
+  // (blocky at 4K). That stretch - one opaque draw reading only one resolve destination (>= 640 guest wide; its
+  // shader binds it twice, signed and unsigned) into a
+  // wider area of one colour target, no depth - is followed by a linear blit of the host image over the area it can
+  // write (scissor, bounded by the viewport), replacing its result (same colours: the pass changes none).
+  // BOTS_GFX_PLAIN_UPSCALE=0 turns it off.
+  static const bool plain_upscale = [] {
+    const char* v = std::getenv("BOTS_GFX_PLAIN_UPSCALE");
+    return !(v && *v == '0');
+  }();
+  if (plain_upscale && scale_ != 1.0f && attachments.color[0] && !draw_reads_.empty()) {
+    Image* source = draw_reads_[0];
+    for (Image* read : draw_reads_) {
+      if (read->width > source->width) source = read;
+    }
+    Image* dest = attachments.color[0];
+    // Where the draw can write (scissor, bounded by the viewport when it has one), in host pixels.
+    const uint32_t x0 = sx, y0 = sy;
+    uint32_t x1 = sx + scissor_rect.extent.width, y1 = sy + scissor_rect.extent.height;
+    if (viewport.xy_extent[0] && viewport.xy_extent[1]) x1 = std::min(x1, viewport_x1), y1 = std::min(y1, viewport_y1);
+    x1 = std::min(x1, dest->width), y1 = std::min(y1, dest->height);
+    const bool wider = x1 > x0 && y1 > y0 && x1 - x0 > source->width && source->width >= Host(640u) &&
+                       source->aspect == VK_IMAGE_ASPECT_COLOR_BIT;
+    if (wider) {
+      const bool one_image = std::ranges::all_of(draw_reads_, [&](const Image* read) { return read == source; });
+      const bool ok = one_image && !attachments.color[1] && !attachments.depth && key.write_mask[0] == 0xF &&
+                      key.blend[0] == 0x00010001 && source->format == dest->format;
+      static int logged = 0;
+      if (logged < 8) {
+        ++logged;
+        REXLOG_INFO("gfx native: plain upscale {}: {}x{} -> {},{}-{},{} of {}x{} (count {}, reads {}{}, textures {}+{}, rt1 {}, "
+                    "depth {}, mask {:X}, blend {:08X}, formats {} -> {})",
+                    ok ? "done" : "skipped", source->width, source->height, x0, y0, x1, y1, dest->width,
+                    dest->height, count, draw_reads_.size(), one_image ? " of one image" : " of different images", vtextures.size(), ptextures.size(), attachments.color[1] ? 1 : 0,
+                    attachments.depth ? 1 : 0, key.write_mask[0], key.blend[0], int(source->format),
+                    int(dest->format));
+      }
+      if (ok) {
+        EndRendering("plain upscale");
+        Access({&source, 1}, {&dest, 1});
+        VkImageBlit blit{};
+        blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        blit.srcOffsets[1] = {int32_t(source->width), int32_t(source->height), 1};
+        blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        blit.dstOffsets[0] = {int32_t(x0), int32_t(y0), 0};
+        blit.dstOffsets[1] = {int32_t(x1), int32_t(y1), 1};
+        vk_.vkCmdBlitImage(cmd_, source->image, VK_IMAGE_LAYOUT_GENERAL, dest->image, VK_IMAGE_LAYOUT_GENERAL, 1,
+                           &blit, VK_FILTER_LINEAR);
+        dest->written = ++write_clock_;
+      }
+    }
+  }
