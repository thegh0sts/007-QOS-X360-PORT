diff --git a/src/gfx/vk/texture_worker.h b/src/gfx/vk/texture_worker.h
new file mode 100644
index 0000000..e85cdd7
--- /dev/null
+++ b/src/gfx/vk/texture_worker.h
@@ -0,0 +1,69 @@
+// qos (patch 0099): a third render thread for texture work. BOTS_GFX_WORKER=1 (the launcher's "Render threads: 3")
+// starts it. A texture level big enough (>= 64 KB of guest data) is copied out of guest memory in two halves: the
+// render thread untiles / byte-swaps / BC-decodes the first half of its rows, this worker the second half, at the same
+// time; the render thread then waits for the worker and records the upload as before. Nothing is kept between
+// textures, so the worst case is the same time as without it.
+#pragma once
+
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+namespace bots::gfx::vk {
+
+class TextureWorker {
+ public:
+  TextureWorker() : thread_([this] { Run(); }) {}
+  ~TextureWorker() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      quit_ = true;
+    }
+    cv_.notify_all();
+    thread_.join();
+  }
+  TextureWorker(const TextureWorker&) = delete;
+  TextureWorker& operator=(const TextureWorker&) = delete;
+
+  // Hands job to the worker; Wait() returns once it has run. One job at a time.
+  void Start(std::function<void()> job) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      job_ = std::move(job);
+      busy_ = true;
+    }
+    cv_.notify_all();
+  }
+  void Wait() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    done_cv_.wait(lock, [this] { return !busy_; });
+  }
+  uint64_t jobs() const { return jobs_; }
+
+ private:
+  void Run() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    for (;;) {
+      cv_.wait(lock, [this] { return quit_ || (busy_ && job_); });
+      if (quit_) return;
+      std::function<void()> job = std::move(job_);
+      job_ = nullptr;
+      lock.unlock();
+      job();
+      lock.lock();
+      busy_ = false;
+      ++jobs_;
+      done_cv_.notify_all();
+    }
+  }
+
+  std::mutex mutex_;
+  std::condition_variable cv_, done_cv_;
+  std::function<void()> job_;
+  bool busy_ = false, quit_ = false;
+  uint64_t jobs_ = 0;
+  std::thread thread_;
+};
+
+}  // namespace bots::gfx::vk
