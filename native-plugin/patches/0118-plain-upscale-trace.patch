+// qos (0118): see renderer.h (probe_).
+void Renderer::ProbeDraw(Image* target, int tag) {
+  static const std::pair<int, int> at = [] {
+    int x = -1, y = -1;
+    if (const char* v = std::getenv("BOTS_TRACE_PROBE")) std::sscanf(v, "%d,%d", &x, &y);
+    return std::pair<int, int>{x, y};
+  }();
+  if (at.first < 0 || target->aspect != VK_IMAGE_ASPECT_COLOR_BIT) return;
+  const uint32_t x = Host(uint32_t(at.first)), y = Host(uint32_t(at.second));
+  if (x >= target->width || y >= target->height) return;
+  constexpr uint32_t kSlots = 4096, kSlotBytes = 16;
+  if (!probe_.buffer && !CreateBuffer(probe_, kSlots * kSlotBytes, VK_BUFFER_USAGE_TRANSFER_DST_BIT)) return;
+  if (probe_draws_.size() >= kSlots) return;
+  EndRendering("probe");
+  Access({&target, 1}, {});
+  VkBufferImageCopy region{};
+  region.bufferOffset = VkDeviceSize(probe_draws_.size()) * kSlotBytes;
+  region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.imageOffset = {int32_t(x), int32_t(y), 0};
+  region.imageExtent = {1, 1, 1};
+  vk_.vkCmdCopyImageToBuffer(Cmd(), target->image, VK_IMAGE_LAYOUT_GENERAL, probe_.buffer, 1, &region);
+  probe_draws_.push_back({stats_.draws, tag ? tag : int(target->format)});
+}
+
+void Renderer::PrintProbes() {
+  if (probe_draws_.empty() || !probe_.mapping) return;
+  if (vk_.vkDeviceWaitIdle) vk_.vkDeviceWaitIdle(device_->device());
+  vmaInvalidateAllocation(allocator_, probe_.allocation, 0, VK_WHOLE_SIZE);
+  for (size_t i = 0; i < probe_draws_.size(); ++i) {
+    const uint8_t* p = probe_.mapping + i * 16;
+    std::fprintf(stderr, "probe draw %llu: %02X %02X %02X %02X (format %d)\n",
+                 (unsigned long long)probe_draws_[i].first, p[0], p[1], p[2], p[3], int(probe_draws_[i].second));
+  }
+  std::fflush(stderr);
+  probe_draws_.clear();
+}
