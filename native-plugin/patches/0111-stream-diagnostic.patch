+// qos (patch 0111): see LogStreamDiag.
+void Renderer::StreamDiagDraw(const rg::RegisterFile& regs, const ShaderCache::Shader& vshader, const Draw& draw,
+                              uint32_t count, bool dma, bool index32) {
+  bool span_known = false, any = false;
+  uint32_t lo = 0, hi = 0;
+  auto span = [&]() -> bool {
+    if (span_known) return lo <= hi;
+    span_known = true;
+    const uint32_t offset = regs.values[rg::XE_GPU_REG_VGT_INDX_OFFSET] & 0xFFFFFF;
+    if (!dma) {
+      lo = offset, hi = (offset + count - 1) & 0xFFFFFF;
+      if (hi < lo) lo = 1, hi = 0;  // wrapped: unknown
+      return lo <= hi;
+    }
+    const uint8_t* src = memory_(draw.index_base);
+    if (!src || !count) {
+      lo = 1, hi = 0;
+      return false;
+    }
+    const auto t0 = std::chrono::steady_clock::now();
+    const bool reset_enabled = regs.Get<reg::PA_SU_SC_MODE_CNTL>().multi_prim_ib_ena;
+    const uint32_t reset_index = regs.Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx;
+    const xe::Endian endian = IndexEndian(draw.index_endian, index32);
+    uint32_t mn = UINT32_MAX, mx = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+      uint32_t v;
+      if (index32) {
+        std::memcpy(&v, src + size_t(i) * 4, 4);
+        v = xe::GpuSwap(v, endian);
+      } else {
+        uint16_t h;
+        std::memcpy(&h, src + size_t(i) * 2, 2);
+        v = xe::GpuSwap(h, endian);
+      }
+      if (reset_enabled && v == reset_index) continue;
+      mn = std::min(mn, v), mx = std::max(mx, v);
+    }
+    sdiag_.scan_ns += uint64_t(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+    sdiag_.scanned += count;
+    if (mn > mx) {
+      lo = 1, hi = 0;
+      return false;
+    }
+    lo = (mn + offset) & 0xFFFFFF, hi = (mx + offset) & 0xFFFFFF;
+    if (hi < lo) lo = 1, hi = 0;
+    return lo <= hi;
+  };
+  const auto& vfetch_bitmap = vshader.constant_register_map().vertex_fetch_bitmap;
+  for (uint32_t i = 0; i < std::size(vfetch_bitmap); ++i) {
+    for (uint32_t bits = vfetch_bitmap[i]; bits; bits &= bits - 1) {
+      const uint32_t constant = i * 32 + std::countr_zero(bits);
+      const auto fetch = regs.GetVertexFetch(constant);
+      if (fetch.type != xe::FetchConstantType::kVertex) continue;
+      const uint32_t start = fetch.address << 2, size = fetch.size << 2;
+      if (!tracker_->StreamDiagHot(start, size)) continue;
+      ++sdiag_.requests, sdiag_.requested += size;
+      if (!any) {
+        any = true;
+        ++sdiag_.draws;
+        ++(dma ? sdiag_.indexed : sdiag_.auto_index);
+      }
+      uint32_t stride = 0;
+      for (const auto& binding : vshader.vertex_bindings()) {
+        if (binding.fetch_constant == constant) stride = std::max(stride, binding.stride_words);
+      }
+      if (!stride || !span()) {
+        ++sdiag_.unknown;
+        sdiag_.spanned += size;
+        continue;
+      }
+      const uint64_t bytes = std::min<uint64_t>(uint64_t(hi - lo + 1) * stride * 4, size);
+      sdiag_.spanned += bytes;
+      sdiag_.big += bytes > (256u << 10);
+    }
+  }
+}
