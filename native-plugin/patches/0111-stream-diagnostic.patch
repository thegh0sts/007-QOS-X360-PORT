+  if (!stream_diag_ || frames <= 0) return;
+  const StreamDiag& a = sdiag_;
+  StreamDiag& b = sdiag_last_;
+  auto per = [&](uint64_t x, uint64_t y) { return double(x - y) / frames; };
+  const double draws = per(a.draws, b.draws);
+  REXLOG_INFO("gfx native: streamed-vertex diagnostic per frame: {:.0f} draws read hot pages ({:.0f} indexed, {:.0f} "
+              "auto-indexed, {:.0f} span unknown), {:.0f} vertex requests on them: {:.2f} MB requested, {:.2f} MB "
+              "spanned by their vertices ({:.1f} KB a draw; {:.0f} draws over 256 KB); index scan {:.3f} ms for "
+              "{:.0f} indices",
+              draws, per(a.indexed, b.indexed), per(a.auto_index, b.auto_index), per(a.unknown, b.unknown),
+              per(a.requests, b.requests), per(a.requested, b.requested) / 1048576.0,
+              per(a.spanned, b.spanned) / 1048576.0, draws > 0 ? per(a.spanned, b.spanned) / 1024.0 / draws : 0.0,
+              per(a.big, b.big), per(a.scan_ns, b.scan_ns) / 1e6, per(a.scanned, b.scanned));
+  b = a;
+}
