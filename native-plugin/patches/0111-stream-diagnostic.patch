+// qos (patch 0111) -------------------------------------------------------------------------------------------------
+
+void MemorySync::SweepHot(uint32_t frame) {
+  if (frame == sweep_frame_) return;
+  sweep_frame_ = frame;
+  std::erase_if(hot_list_, [&](uint32_t page) {
+    if (frame - page_frame_[page] <= 2) return false;
+    hot_bits_[page >> 6] &= ~(uint64_t(1) << (page & 63));
+    return true;
+  });
+}
+
+void MemorySync::StreamDiagUpload(uint32_t page_first, uint32_t page_count) {
+  const uint32_t frame = uint32_t(renderer_.frame_number()) + 1;  // 0 = never
+  SweepHot(frame);
+  bool all_hot = true;
+  for (uint32_t page = page_first; page < page_first + page_count; ++page) {
+    const uint32_t last = page_frame_[page];
+    if (last != frame) {
+      ++spages_.distinct;
+      page_streak_[page] = last == frame - 1 ? uint8_t(std::min(page_streak_[page] + 1, 250)) : 1;
+      page_frame_[page] = frame;
+      if (page_streak_[page] >= 3 && !(hot_bits_[page >> 6] & (uint64_t(1) << (page & 63)))) {
+        hot_bits_[page >> 6] |= uint64_t(1) << (page & 63);
+        hot_list_.push_back(page);
+      }
+    }
+    const bool hot = page_streak_[page] >= 3;
+    spages_.hot_pages += hot;
+    all_hot = all_hot && hot;
+  }
+  spages_.pages += page_count;
+  ++spages_.runs;
+  spages_.hot_runs += all_hot;
+  spages_.hot_now += hot_list_.size(), ++spages_.samples;
+}
+
+bool MemorySync::StreamDiagHot(uint32_t start, uint32_t length) {
+  if (!stream_diag_ || !length || start >= kBufferSize) return false;
+  SweepHot(uint32_t(renderer_.frame_number()) + 1);
+  if (hot_list_.empty()) return false;
+  const uint32_t page_first = start >> page_size_log2();
+  const uint32_t page_last = uint32_t(std::min<uint64_t>(uint64_t(start) + length, kBufferSize) - 1) >> page_size_log2();
+  for (uint32_t block = page_first >> 6; block <= page_last >> 6; ++block) {
+    const uint32_t lo = block == page_first >> 6 ? page_first & 63 : 0;
+    const uint32_t hi = block == page_last >> 6 ? page_last & 63 : 63;
+    const uint64_t bits = (hi == 63 ? ~uint64_t(0) : (uint64_t(1) << (hi + 1)) - 1) & ~((uint64_t(1) << lo) - 1);
+    if (hot_bits_[block] & bits) return true;
+  }
+  return false;
+}
+
+void MemorySync::LogStreamPages(double frames) {
+  if (!stream_diag_ || frames <= 0) return;
+  const StreamPages& a = spages_;
+  StreamPages& b = spages_last_;
+  auto per = [&](uint64_t x, uint64_t y) { return double(x - y) / frames; };
+  const double pages = per(a.pages, b.pages), runs = per(a.runs, b.runs);
+  REXLOG_INFO("gfx native: hot pages per frame: {:.0f} pages uploaded ({:.0f} different) in {:.0f} runs; {:.0f} of "
+              "those pages ({:.0f}%) and {:.0f} runs ({:.0f}%) hot (uploaded 3+ frames running); ~{:.0f} pages hot",
+              pages, per(a.distinct, b.distinct), runs, per(a.hot_pages, b.hot_pages),
+              pages > 0 ? 100.0 * per(a.hot_pages, b.hot_pages) / pages : 0.0, per(a.hot_runs, b.hot_runs),
+              runs > 0 ? 100.0 * per(a.hot_runs, b.hot_runs) / runs : 0.0,
+              a.samples > b.samples ? double(a.hot_now - b.hot_now) / double(a.samples - b.samples) : 0.0);
+  b = a;
+}
+
 }  // namespace bots::gfx::vk
