+void Renderer::NoteSharedRead(uint32_t start, uint32_t length) {
+  if (!hoist_uploads_ || !length) return;
+  const uint64_t end = std::min<uint64_t>(uint64_t(start) + length, uint64_t(page_read_stamp_.size()) << 12);
+  for (uint64_t page = start >> 12; page < (end + 4095) >> 12; ++page) page_read_stamp_[page] = page_stamp_;
+}
+
+bool Renderer::ReadThisSubmission(uint32_t start, uint32_t length) const {
+  const uint64_t end = uint64_t(start) + length;
+  if (end > uint64_t(page_read_stamp_.size()) << 12) return true;
+  for (uint64_t page = start >> 12; page < (end + 4095) >> 12; ++page) {
+    if (page_read_stamp_[page] == page_stamp_) return true;
+  }
+  return false;
+}
+
+// qos (patch 0102): an upload no work recorded so far in this submission reads (or could read) doesn't need to sit
+// where it was asked for: the copy goes into the submission's pre_cmd, which runs before everything recorded in cmd.
+// So the render pass isn't ended for it and no barriers are added there (one barrier ends pre_cmd). Before, every
+// upload split the pass it came in (~1,460 passes a frame in busy scenes, most of them for vertex data the game
+// rewrites each frame). False: not possible here (the caller uploads in place).
+bool Renderer::HoistUpload(uint32_t start, uint32_t length) {
+  if (!hoist_uploads_ || ReadThisSubmission(start, length)) return false;
+  // Ring space for all of it first: a full ring means a flush, which the in-place path handles.
+  if (ring_used_ + length + 16 > ring_.size || length > ring_.size / 4) return false;
+  if (!recording_) BeginCommands();  // Flush submits pre_cmd only with cmd
+  Submission& s = submissions_[current_];
+  if (!s.pre_recording) {
+    const VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO, nullptr,
+                                         VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+    vk_.vkBeginCommandBuffer(s.pre_cmd, &begin);
+    // Earlier submissions may still read what these copies overwrite.
+    const VkMemoryBarrier barrier{VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr,
+                                  VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_TRANSFER_WRITE_BIT};
+    vk_.vkCmdPipelineBarrier(s.pre_cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1,
+                             &barrier, 0, nullptr, 0, nullptr);
+    s.pre_recording = true;
+  }
+  VkDeviceSize offset;
+  uint8_t* staging = Upload(length, 16, offset);
+  if (!staging) return false;
+  std::memcpy(staging, memory_(start), length);
+  const VkBufferCopy region{offset, start, length};
+  vk_.vkCmdCopyBuffer(s.pre_cmd, ring_.buffer, shared_memory_.buffer, 1, &region);
+  stats_.uploaded_bytes += length;
+  ++stats_.uploads_hoisted;
+  return true;
+}
