+                "page runs uploaded ({:.0f} pages); CPU write faults {:.0f}, invalidating {:.0f} pages",
+                per(now.locked, a.locked), ms(now.slow_ns, a.slow_ns), ms(now.scan_ns, a.scan_ns),
+                ms(now.protect_ns, a.protect_ns), ms(now.copy_ns, a.copy_ns), per(now.runs, a.runs),
+                per(now.pages, a.pages), per(now.faults, a.faults), per(now.fault_pages, a.fault_pages));
+    sync_mark_ = now;
+  }
