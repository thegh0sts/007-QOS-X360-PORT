+  // qos (patch 0109): the memory tracker's slow path per frame (BOTS_DRAW_PROFILE=1), and the CPU's write faults.
+  struct SyncMark {
+    uint64_t slow_ns = 0, scan_ns = 0, protect_ns = 0, copy_ns = 0, runs = 0, pages = 0, fault_pages = 0, faults = 0,
+             locked = 0;
+  } sync_mark_;
+
+  void LogSyncProfile(double n) {
+    const auto& p = sync_->profile();
+    SyncMark now{p.slow_ns, p.scan_ns, p.protect_ns, p.copy_ns, p.runs, p.pages,
+                 p.fault_pages.load(std::memory_order_relaxed), sync_->invalidations(), sync_->locked()};
+    const SyncMark& a = sync_mark_;
+    auto ms = [&](uint64_t b, uint64_t x) { return double(b - x) / 1e6 / n; };
+    auto per = [&](uint64_t b, uint64_t x) { return double(b - x) / n; };
+    REXLOG_INFO("gfx native: memory sync per frame: {:.0f} requests found an invalid page, {:.2f} ms in them (SDK "
